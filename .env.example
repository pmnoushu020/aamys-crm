# Aamys CRM - Environment Configuration Example
# Copy this file to .env and fill in your MongoDB Atlas credentials:
# cp .env.example .env

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers -> Node.js
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/aamys_crm?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your_cluster.mongodb.net/aamys_crm?retryWrites=true&w=majority

# API URL for Frontend
VITE_API_URL=http://localhost:5000/api
